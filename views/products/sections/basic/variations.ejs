<div class="pf-panel pf-variations-box" data-variations-overview>
  <div class="pf-empty" data-variations-empty>
    <i data-lucide="boxes" class="pf-empty__icon"></i>
    <p class="pf-empty__title">No variations added yet.</p>
    <p class="pf-empty__text">Select attributes, add values and generate variations.</p>
    <button type="button" class="btn btn--primary btn--sm" data-open-variations><i data-lucide="plus"></i> Add Variations</button>
  </div>
  <div class="pf-var-overview" data-variations-list hidden></div>
</div>
