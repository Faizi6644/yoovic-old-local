<div class="pf-step" data-step="fby-done" hidden>
  <section class="pf-page pf-done">
    <span class="pf-done__icon"><i data-lucide="check"></i></span>
    <h1 class="pf-title">FBY Shipment Submitted</h1>
    <p class="pf-lead">Your shipment is on its way to the warehouse queue. Keep the shipment ID for your records.</p>
    <p class="pf-done__id">Shipment ID: <strong data-done-id></strong></p>
    <div class="pf-panel pf-done__summary"><dl class="pf-kv pf-kv--left" data-done-summary></dl></div>
    <div class="pf-done__actions">
      <button type="button" class="btn pf-btn-outline" data-label-print><i data-lucide="printer"></i> Print Labels</button>
      <a class="btn pf-btn-outline" href="/products/add"><i data-lucide="plus"></i> Add Another Product</a>
      <a class="btn btn--primary" href="/dashboard"><i data-lucide="house"></i> Dashboard</a>
    </div>
  </section>
</div>
