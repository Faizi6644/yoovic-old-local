<% if (g === null || g === undefined || !isFinite(g)) { %><span class="delta delta--flat">—</span><% } else { const up = g >= 0; %><span class="delta <%= up ? 'delta--up' : 'delta--down' %>"><span aria-hidden="true"><%= up ? '↑' : '↓' %></span><span class="sr-only"><%= up ? 'up' : 'down' %></span> <%= Math.abs(g).toFixed(1) %>%</span><% } %>
